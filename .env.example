PORT=3000
DATABASE_PATH=data/donations.sqlite
PUBLIC_BASE_URL=http://localhost:3000

# Flutterwave: KES M-Pesa and USD Visa/Mastercard checkout
FLW_SECRET_KEY=FLWSECK_TEST-replace-with-test-secret
FLW_SECRET_HASH=replace-with-webhook-secret-hash

# PayPal developer sandbox first; use PAYPAL_ENV=live only after testing
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret

# Binance Pay merchant API credentials
BINANCE_PAY_API_SECRET=replace-with-binance-pay-api-secret
BINANCE_PAY_CERTIFICATE_SN=replace-with-binance-pay-certificate-serial

# NOWPayments hosted BTC checkout and IPN signature verification
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_API_KEY=replace-with-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret
