PORT=3000
DATABASE_PATH=data/donations.sqlite
PUBLIC_BASE_URL=http://localhost:3000

# Safaricom Daraja STK Push (direct M-Pesa)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=replace-with-daraja-consumer-key
MPESA_CONSUMER_SECRET=replace-with-daraja-consumer-secret
MPESA_SHORTCODE=replace-with-business-shortcode
MPESA_PASSKEY=replace-with-stk-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Pesapal API 3.0 (Visa/Mastercard)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=replace-with-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=replace-with-pesapal-consumer-secret
PESAPAL_IPN_ID=replace-with-registered-pesapal-ipn-id

# PayPal developer sandbox first; use PAYPAL_ENV=live only after testing
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-client-secret

# Binance Pay merchant API credentials
BINANCE_PAY_API_SECRET=replace-with-binance-pay-api-secret
BINANCE_PAY_CERTIFICATE_SN=replace-with-binance-pay-certificate-serial

# NOWPayments hosted BTC checkout and IPN signature verification
NOWPAYMENTS_ENV=sandbox
NOWPAYMENTS_API_KEY=replace-with-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=replace-with-nowpayments-ipn-secret
